---
import '../styles/fonts.css';
import '../styles/bot-landing.css';
import Header from '../components/Header.astro';
import SubpageHeader from '../components/SubpageHeader.astro';
import '../styles/subpages.css';
import Footer from '../components/Footer.astro';
import { alternatePath, type Locale } from '../data/site';

interface Props {
  lang?: Locale;
  title: string;
  description: string;
  ogImage?: string;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  preloadImage?: string;
  noindex?: boolean;
  section?: "download" | "docs";
}

const {
  lang = 'en',
  title,
  description,
  ogImage = lang === 'en' ? '/og-cover.jpg' : '/og-cover-zh.jpg',
  jsonLd,
  preloadImage,
  noindex = false,
  section,
} = Astro.props as Props;

const site = Astro.site ?? new URL('https://ohmybot.si');
const canonical = new URL(Astro.url.pathname, site);
const ogImageUrl = new URL(ogImage, site);
const htmlLang = lang === 'en' ? 'en' : 'zh-CN';
---
<!doctype html>
<html lang={htmlLang} data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#fafaf8" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0b0c12" media="(prefers-color-scheme: dark)" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="CaelisBot" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={lang === 'en' ? 'en_US' : 'zh_CN'} />
    <meta property="og:locale:alternate" content={lang === 'en' ? 'zh_CN' : 'en_US'} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={lang === 'en' ? 'CaelisBot — a companion on your desktop, an agent for your day.' : 'CaelisBot——桌面上有个伴，也是个能办事的助手。'} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    {!noindex && (
      <>
        <link rel="canonical" href={canonical} />
        <link rel="alternate" hreflang={lang === 'en' ? 'en' : 'zh-CN'} href={canonical} />
        <link rel="alternate" hreflang={lang === 'en' ? 'zh-CN' : 'en'} href={new URL(alternatePath(Astro.url.pathname), site)} />
        <link rel="alternate" hreflang="x-default" href={new URL(Astro.url.pathname.replace(/^\/zh-cn(?=\/)/, ''), site)} />
      </>
    )}
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="icon" href="/favicon-64.png" sizes="64x64" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    {preloadImage && <link rel="preload" as="image" href={preloadImage} fetchpriority="high" />}
    <script is:inline src="/theme.js"></script>
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body class={section ? `subpage subpage-${section}` : undefined}>
    {section ? <SubpageHeader lang={lang} section={section}/> : <Header lang={lang} />}
    <main id="main"><slot /></main>
    <Footer lang={lang} />
    <script>import '../scripts/bot-landing';</script>
  </body>
</html>

---
import Icon from './Icon.astro';
import content from '../data/bot-content.json';
import {alternatePath, type Locale} from '../data/site';
const {lang='en'} = Astro.props as {lang:Locale};const c=content[lang];
---
<a class="skip-link" href="#main">{lang==='en'?'Skip to content':'跳转到正文'}</a>
<header class="site-header"><div class="header-inner"><a class="brand" href={lang==='en'?'/':'/zh-cn/'} aria-label="CaelisBot home"><img src="/bot-icon.png" width="32" height="32" alt=""/><span>CaelisBot<span class="brand-dot">.</span></span></a><nav class="desktop-nav" aria-label={lang==='en'?'Main navigation':'主导航'}><a href="#everyday">{c.navExplore}</a><a href="#faq">{c.navFAQ}</a><a href="https://github.com/caelis-labs/caelis-bot">GitHub<Icon name="external" size={13}/></a></nav><div class="header-tools"><a class="language-link" href={alternatePath(Astro.url.pathname)} aria-label={lang==='en'?'切换到中文':'Switch to English'} lang={lang==='en'?'zh-CN':'en'}>{lang==='en'?'中文':'EN'}</a><button class="icon-button theme-toggle" type="button" data-theme-toggle aria-label={lang==='en'?'Switch theme':'切换主题'}><span class="theme-sun"><Icon name="sun" size={18}/></span><span class="theme-moon"><Icon name="moon" size={18}/></span></button><a class="nav-download" href="#download">{c.navGet}<Icon name="arrow" size={16}/></a></div></div></header>

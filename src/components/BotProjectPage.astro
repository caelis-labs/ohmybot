---
import SiteLayout from '../layouts/SiteLayout.astro';
import BotDownload from './BotDownload.astro';
import content from '../data/bot-content.json';
import demo from '../data/bot-media.json';
import { localePath, type Locale, type Project } from '../data/site';
import '../styles/bot-project.css';
const { lang, project } = Astro.props as { lang: Locale; project: Project };
const zh = lang === 'zh-cn';
const story = content[lang];
const media = demo[lang];
const independent = Astro.site?.hostname === 'ohmybot.si';
const guide = (page: string) => `${independent ? 'https://caelis.dev' : ''}${localePath(lang, `/docs/caelis-bot/${page}/`)}`;
---
<SiteLayout lang={lang} title={project.name} description={project[lang].description} compactFooter>
  <div class="bot-product">
    <section class="page-hero bot-page-hero" id="top">
      <div class="container bot-intro">
        <div><p class="eyebrow">{zh ? '桌面上的个人助手' : 'YOUR DESKTOP ASSISTANT'}</p><h1>Caelis Bot<span class="heading-period">.</span></h1><p class="bot-promise">{zh ? '交代任务，继续手头的事。' : 'Hand off a task. Keep your focus.'}</p></div>
        <div class="bot-get"><BotDownload lang={lang}/><span>macOS · Apple Silicon / Windows · x64</span></div>
      </div>
    </section>

    <section class="container bot-demo-section" aria-labelledby="bot-demo-title">
      <div class="bot-demo-heading"><h2 id="bot-demo-title">{zh ? '一起把想法，变成进展。' : 'A little companion. Real progress.'}</h2><span>{demo.ready ? `${demo.duration} ${zh ? '秒' : 'seconds'} · ${demo.platform}` : story.mediaLabel}</span></div>
      {demo.ready ? <>
        <div class="bot-film" data-bot-demo>
          <video autoplay muted loop playsinline preload="metadata" poster={`${media.base}.webp`} width="1600" height="900" aria-label={media.description}>
            <source src={`${media.base}.mp4`} type="video/mp4"/>
            <track kind="captions" src={`${media.base}.vtt`} srclang={zh ? 'zh-CN' : 'en'} label={zh ? '中文' : 'English'}/>
            {zh ? '你的浏览器不支持视频播放。' : 'Your browser does not support video playback.'}
          </video>
          <button class="bot-playback" type="button" data-playback data-state="paused" data-play-label={zh ? '播放演示' : 'Play demo'} data-pause-label={zh ? '暂停演示' : 'Pause demo'} aria-label={zh ? '播放演示' : 'Play demo'} hidden>
            <svg class="bot-play-icon" viewBox="0 0 20 20" aria-hidden="true"><path d="m6 3 11 7-11 7Z" fill="currentColor"/></svg>
            <svg class="bot-pause-icon" viewBox="0 0 20 20" aria-hidden="true"><path d="M5 3h3v14H5zm7 0h3v14h-3z" fill="currentColor"/></svg>
          </button>
        </div>
        <p class="bot-media-note">{media.description} · {demo.sourceVersion}</p>
      </> : <>
        <div class="bot-film bot-media-pending" data-media-pending>
          <img src={independent ? '/bot-icon.png' : '/assets/bot/logo-256.webp'} width="128" height="128" alt=""/>
          <h3>{story.pendingTitle}</h3><p>{story.pendingBody}</p>
        </div>
        <p class="bot-media-note">{story.mediaNote}</p>
      </>}
    </section>

    <section class="container bot-scenarios" aria-labelledby="bot-scenarios-title">
      <div class="bot-section-heading"><h2 id="bot-scenarios-title">{zh ? '一起做事，也留住上下文。' : 'Useful work. A familiar presence.'}</h2><p>{zh ? '三个值得试一试的方向。' : 'Three ways to work with Bot.'}</p></div>
      {story.scenarios.map((scenario,i) => <article class="bot-scenario"><div class="bot-scenario-title"><span>{String(i+1).padStart(2,'0')}</span><div><h3>{scenario.title}</h3></div></div><div class="bot-scenario-example"><p>{scenario.input}</p><blockquote>{scenario.prompt}</blockquote><p class="bot-outcome">{scenario.output}</p></div></article>)}
      <p class="bot-runtime-note">{zh ? '模型、工具和你允许的访问范围，决定 Bot 可以完成的工作。需要账号、系统权限或你作出决定时，会请你参与。' : 'Models, tools and the access you allow shape what Bot can do. Account login, system permissions and decisions that need you remain in your hands.'}</p>
    </section>

    <section class="container bot-details" aria-labelledby="bot-setup-title">
      <div class="bot-section-heading"><h2 id="bot-setup-title">{story.setupTitle}</h2><p>{story.setupIntro}</p></div>
      {story.setup.map(([title,body],i) => <article class="bot-scenario"><div class="bot-scenario-title"><span>{String(i+1).padStart(2,'0')}</span><h3>{title}</h3></div><div class="bot-scenario-example"><p>{body}</p></div></article>)}
      <p class="bot-runtime-note">{story.windowsNotice} <a class="text-link" href={guide('installation')}>{story.guide} ↗</a></p>
    </section>

    <section class="container bot-details" aria-labelledby="bot-connections-title">
      <div class="bot-section-heading"><h2 id="bot-connections-title">{story.connectionsTitle}</h2><p>{story.connectionsIntro}</p></div>
      {story.connections.map(([title,body]) => <article class="bot-scenario"><div class="bot-scenario-title"><h3>{title}</h3></div><div class="bot-scenario-example"><p>{body}</p></div></article>)}
      <a class="text-link" href={guide('conversation')}>{story.modelsGuide} ↗</a>
    </section>

    <section class="container bot-details bot-faq" aria-labelledby="bot-faq-title">
      <div class="bot-section-heading"><h2 id="bot-faq-title">{story.faqTitle}</h2><a class="text-link" href={guide('troubleshooting')}>{story.supportGuide} ↗</a></div>
      {story.faqs.map(([question,answer]) => <details><summary>{question}</summary><p>{answer}</p></details>)}
    </section>
  </div>
  <script>import '../scripts/bot-demo';</script>
</SiteLayout>

---
import type { Locale } from '../data/site';
const { lang = 'en' } = Astro.props as { lang: Locale };
const zh = lang === 'zh-cn';
---
<footer class="site-footer">
  <div class="wrap footer-bottom"><a class="footer-brand" href={zh ? '/zh-cn/' : '/'}>CaelisBot<span>.</span></a><span>© {new Date().getFullYear()} Caelis Labs</span><nav aria-label={zh ? '页脚' : 'Footer'}><a href={zh ? "/zh-cn/docs/" : "/docs/"}>{zh ? "使用指南" : "User guide"}</a><a href="/assets/bot/LICENSE.md">{zh ? '角色许可' : 'Character license'}</a><a href="#top" aria-label={zh ? '返回顶部' : 'Back to top'}>↑</a></nav></div>
</footer>

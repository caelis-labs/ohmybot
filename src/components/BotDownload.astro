---
import Icon from './Icon.astro';
import { type Locale } from '../data/site';
const { lang = 'en' } = Astro.props as { lang?: Locale };
const macDownload = `${Astro.site?.hostname === 'ohmybot.si' ? 'https://caelis.dev' : ''}/download/caelis-bot/`;
---
<div class="actions bot-downloads">
  <a class="button primary" href={macDownload}>{lang === 'en' ? 'Download for macOS' : '下载 macOS 版'}<Icon name="download" size={18}/></a>
  <a class="button secondary" href="https://github.com/caelis-labs/caelis-bot/releases/latest">{lang === 'en' ? 'Windows downloads' : 'Windows 下载'}<Icon name="download" size={18}/></a>
</div>

---
import ProductDemo from "./ProductDemo.astro";
import SiteLayout from '../layouts/SiteLayout.astro';
import Icon from '../components/Icon.astro';
import content from '../data/bot-content.json';
import release from '../data/release.json';
import type { Locale } from '../data/site';

const { lang = 'en' } = Astro.props as { lang: Locale };
const c = content[lang];
const zh = lang === 'zh-cn';
const site = Astro.site ?? new URL('https://ohmybot.si');
const guide = `${zh ? '/zh-cn' : ''}/docs`;
const downloads = zh ? '/zh-cn/download/' : '/download/';

const e = c.experience;

const softwareJsonLd = {
  '@type': 'SoftwareApplication',
  name: 'CaelisBot',
  applicationCategory: 'ProductivityApplication',
  operatingSystem: 'macOS 12+, Windows 10 22H2+, Linux',
  description: c.metaDescription,
  url: new URL(zh ? '/zh-cn/' : '/', site).toString(),
  downloadUrl: new URL(zh ? '/zh-cn/#download' : '/#download', site).toString(),
  softwareVersion: release.version,
  license: release.license,
  sameAs: [release.github],
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
};
const faqJsonLd = {
  '@type': 'FAQPage',
  mainEntity: c.faq.items.map(([question, answer]) => ({
    '@type': 'Question',
    name: question,
    acceptedAnswer: { '@type': 'Answer', text: answer },
  })),
};
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [softwareJsonLd, faqJsonLd],
};
---
<SiteLayout
  lang={lang}
  title={c.metaTitle}
  description={c.metaDescription}
  jsonLd={structuredData}
  preloadImage="/assets/bot/companion-idle-600.webp"
>
  <section class="hero" id="top" aria-labelledby="hero-title">
    <div class="hero-orbit" aria-hidden="true"><i></i><i></i><i></i></div>
    <div class="wrap hero-layout">
      <div class="hero-copy">

        <h1 class="hero-enter" id="hero-title">CaelisBot<span>.</span></h1>
        <p class="hero-promise hero-enter">{e.promise[0]}<br/><span>{e.promise[1]}</span></p>
        <p class="hero-intro hero-enter">{e.intro}</p>
        <div class="hero-actions hero-enter">
          <a class="button primary" href={downloads} data-download-cta data-href-mac={release.macos} data-href-windows={release.windowsSetup} data-href-linux={`${downloads}#linux`} data-href-other={downloads} data-label-mac={c.hero.primary} data-label-windows={c.hero.primaryWindows} data-label-linux={c.hero.primaryLinux} data-label-other={c.nav.download}><span data-download-label>{c.nav.download}</span><Icon name="download" size={18}/></a>
        </div>
      </div>
      <div class="hero-portrait hero-enter" data-parallax>
        <div class="portrait-halo" aria-hidden="true"></div>
        <span class="portrait-greeting">{zh ? '嗯嗯，交给我吧～' : 'Leave it to me ♡'}<span aria-hidden="true">✦</span></span>
        <img src="/assets/bot/companion-idle-600.webp" width="600" height="840" fetchpriority="high" alt={zh ? 'CaelisBot 粉色头发的桌面角色' : 'CaelisBot, the pink-haired desktop companion'}/>
      </div>
    </div>
  </section>

  <section class="story section" id="product" aria-labelledby="product-title">
    <div class="wrap">
      <header class="section-heading reveal"><h2 id="product-title">{e.storyTitle[0]}<br/><span>{e.storyTitle[1]}</span></h2></header>
      <div class="product-stories">
        {e.steps.map((step, index) => <div class="product-story-row" id={['handoff','decisions','events'][index]}>
          <article class="product-story-copy"><h3>{step.title}</h3><div>{step.body.split("\n").map(line => <p>{line}</p>)}</div><a class="text-link" href={`${guide}/${index === 2 ? 'events' : 'conversation'}/`}>{step.link}<Icon name="arrow" size={17}/></a></article>
          <ProductDemo kind={['handoff','decisions','events'][index]} zh={zh}/>
        </div>)}
      </div>
    </div>
  </section>

  <section class="ownership section" id="character" aria-labelledby="ownership-title">
    <div class="wrap">
      <div class="ownership-heading reveal"><h2 id="ownership-title">{e.ownershipTitle[0]}<br/><span>{e.ownershipTitle[1]}</span></h2><p class="ownership-intro">{e.ownershipIntro}</p></div>
      <div class="ownership-grid">
        <article id="models" class="reveal"><h3>{e.modelsTitle}</h3><p>{e.modelsBody}</p></article>
        <article id="privacy" class="reveal"><h3>{e.memoryTitle}</h3><p>{e.memoryBody}</p></article>
      </div>
    </div>
  </section>

  <section class="faq-section section" id="download" aria-labelledby="faq-title">
    <div class="wrap">
      <div class="faq-layout" id="faq"><div class="faq-heading"><h2 id="faq-title">{zh ? '你可能还想知道' : 'A few things to know'}</h2></div><div class="faq-list">{c.faq.items.map(([question, answer]) => <details><summary>{question}<span>+</span></summary><p>{answer}</p></details>)}</div></div>
    </div>
  </section>

</SiteLayout>
